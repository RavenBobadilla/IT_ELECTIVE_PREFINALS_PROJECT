@model IEnumerable<Department>
@{ ViewData["Title"] = "Departments"; }
<h1>Departments</h1><div class="card shadow-sm"><table class="table mb-0"><thead><tr><th>Name</th><th>Description</th><th>Active</th><th>Employees</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Name</td><td>@item.Description</td><td>@(item.IsActive ? "Yes" : "No")</td><td>@item.Employees.Count</td></tr>}</tbody></table></div>
