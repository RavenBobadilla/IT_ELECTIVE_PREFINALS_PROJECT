@model IEnumerable<Team>
@{ ViewData["Title"] = "Teams"; }
<h1>Teams</h1><div class="card shadow-sm"><table class="table mb-0"><thead><tr><th>Team</th><th>Department</th><th>Members</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Name</td><td>@item.Department.Name</td><td>@string.Join(", ", item.TeamMembers.Select(m => m.Employee.FullName))</td></tr>}</tbody></table></div>
