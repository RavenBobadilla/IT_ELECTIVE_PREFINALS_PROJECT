@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<h1>Customers</h1><div class="card shadow-sm"><table class="table mb-0"><thead><tr><th>Company</th><th>Contact name</th><th>Email</th><th>Phone</th><th>Active</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CompanyName</td><td>@item.ContactName</td><td>@item.Email</td><td>@item.Phone</td><td>@(item.IsActive ? "Yes" : "No")</td></tr>}</tbody></table></div>
