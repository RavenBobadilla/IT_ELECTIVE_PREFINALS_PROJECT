@model IEnumerable<Employee>
@{ ViewData["Title"] = "Employees"; }
<h1>Employees</h1><div class="card shadow-sm"><table class="table mb-0"><thead><tr><th>Full name</th><th>Email</th><th>Job title</th><th>Department</th><th>Active</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.FullName</td><td>@item.Email</td><td>@item.JobTitle</td><td>@item.Department.Name</td><td>@(item.IsActive ? "Yes" : "No")</td></tr>}</tbody></table></div>
