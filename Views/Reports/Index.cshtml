@using IT_ELECTIVE_PREFINALS_PROJECT.Models
@{ ViewData["Title"] = "Reports"; var employeeWorkload = ViewBag.EmployeeWorkload; var departmentWorkload = ViewBag.DepartmentWorkload; var unassigned = ViewBag.Unassigned as List<Ticket>; var multiple = ViewBag.MultipleAssignees as List<Ticket>; var primary = ViewBag.PrimaryAssignees as List<Ticket>; var categories = ViewBag.Categories as List<TicketCategory>; }
<h1>Help Desk Reports</h1><p class="text-muted">Required LINQ queries based on the existing database.</p>
<div class="row g-4"><div class="col-lg-6"><div class="card shadow-sm"><div class="card-header bg-white"><h5>Employee workload</h5></div><table class="table mb-0"><thead><tr><th>Employee</th><th>Department</th><th>Unresolved</th></tr></thead><tbody>@foreach(var row in employeeWorkload){<tr><td>@row.Employee</td><td>@row.Department</td><td>@row.Count</td></tr>}</tbody></table></div></div><div class="col-lg-6"><div class="card shadow-sm"><div class="card-header bg-white"><h5>Department workload</h5></div><table class="table mb-0"><thead><tr><th>Department</th><th>Employees</th><th>Unresolved</th></tr></thead><tbody>@foreach(var row in departmentWorkload){<tr><td>@row.Department</td><td>@row.EmployeeCount</td><td>@row.Count</td></tr>}</tbody></table></div></div>
<div class="col-12"><div class="card shadow-sm"><div class="card-header bg-white"><h5>Unassigned tickets</h5></div><table class="table mb-0"><thead><tr><th>ID</th><th>Subject</th><th>Customer</th><th>Priority</th><th>Status</th><th>Created</th></tr></thead><tbody>@foreach(var ticket in unassigned!){<tr><td>@ticket.Id</td><td>@ticket.Subject</td><td>@ticket.Customer.CompanyName</td><td>@ticket.Priority.Name</td><td>@ticket.Status.Name</td><td>@ticket.CreatedAt</td></tr>}</tbody></table></div></div>
<div class="col-lg-6"><div class="card shadow-sm"><div class="card-header bg-white"><h5>Multiple-assignee tickets</h5></div><table class="table mb-0"><thead><tr><th>ID</th><th>Subject</th><th>Active assignees</th><th>Names</th></tr></thead><tbody>@foreach(var ticket in multiple!){<tr><td>@ticket.Id</td><td>@ticket.Subject</td><td>@ticket.Assignments.Count</td><td>@string.Join(", ", ticket.Assignments.Select(a => a.Employee.FullName))</td></tr>}</tbody></table></div></div><div class="col-lg-6"><div class="card shadow-sm"><div class="card-header bg-white"><h5>Primary assignee</h5></div><table class="table mb-0"><thead><tr><th>ID</th><th>Subject</th><th>Primary assignee</th></tr></thead><tbody>@foreach(var ticket in primary!){<tr><td>@ticket.Id</td><td>@ticket.Subject</td><td>@(ticket.Assignments.FirstOrDefault()?.Employee.FullName ?? "Unassigned")</td></tr>}</tbody></table></div></div>
<div class="col-12"><div class="card shadow-sm"><div class="card-header bg-white"><h5>Category hierarchy</h5></div><table class="table mb-0"><thead><tr><th>Category</th><th>Parent category</th></tr></thead><tbody>@foreach(var category in categories!){<tr><td>@category.Name</td><td>@(category.ParentCategory?.Name ?? "Root category")</td></tr>}</tbody></table></div></div></div>
