@model Ticket
@{ ViewData["Title"] = "Ticket #" + Model.Id; var comments = ViewBag.Comments as List<TicketComment>; var assignments = ViewBag.Assignments as List<TicketAssignment>; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><a asp-action="Index" class="text-decoration-none">← All tickets</a><h1 class="mt-2">#@Model.Id — @Model.Subject</h1></div><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit ticket</a></div>
<div class="row g-4"><div class="col-lg-8"><div class="card card-body shadow-sm mb-4"><h5>Description</h5><p class="mb-0 description-text">@Model.Description</p></div><div class="card shadow-sm"><div class="card-header bg-white"><h5 class="mb-0">Conversation</h5></div><div class="card-body">@if (comments?.Any() == true) { foreach (var comment in comments) { <div class="comment"><strong>@(comment.Employee?.FullName ?? "Customer")</strong><small class="text-muted ms-2">@comment.CreatedAt</small><p class="mb-0">@comment.Comment</p></div> } } else { <p class="text-muted">No comments yet.</p> }<form asp-action="AddComment" method="post" class="mt-3"><input type="hidden" name="ticketId" value="@Model.Id" /><label class="form-label">Add a comment</label><textarea class="form-control" name="comment" rows="3" required></textarea><button class="btn btn-outline-primary mt-2">Post comment</button></form></div></div></div><div class="col-lg-4"><div class="card card-body shadow-sm"><h5>Ticket details</h5><dl class="row mb-0"><dt class="col-5">Status</dt><dd class="col-7">@Model.Status.Name</dd><dt class="col-5">Priority</dt><dd class="col-7"><span class="badge priority-@Model.Priority.Name.ToLower()">@Model.Priority.Name</span></dd><dt class="col-5">Customer</dt><dd class="col-7">@Model.Customer.CompanyName</dd><dt class="col-5">Category</dt><dd class="col-7">@Model.Category.Name</dd><dt class="col-5">Created</dt><dd class="col-7">@Model.CreatedAt</dd><dt class="col-5">Due</dt><dd class="col-7">@(Model.DueAt ?? "Not set")</dd></dl><hr /><h6>Assigned staff</h6>@if (assignments?.Any() == true) { <ul>@foreach (var assignment in assignments) { <li>@assignment.Employee.FullName</li> }</ul> } else { <span class="text-muted">Not assigned</span> }<h6 class="mt-3">Tags</h6>@if(Model.TicketTags.Any()){<div>@foreach(var ticketTag in Model.TicketTags){<span class="badge bg-secondary me-1">@ticketTag.Tag.Name</span>}</div>}else{<span class="text-muted">No tags</span>}<h6 class="mt-3">Attachments</h6>@if(Model.Attachments.Any()){<ul class="mb-0">@foreach(var attachment in Model.Attachments){<li>@attachment.FileName <small class="text-muted">(@attachment.FileSize bytes)</small></li>}</ul>}else{<span class="text-muted">No attachments</span>}</div></div></div>
