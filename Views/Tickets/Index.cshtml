@model IEnumerable<Ticket>
@{ ViewData["Title"] = "Tickets"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="mb-0">Tickets</h1><p class="text-muted mb-0">Search and manage support requests.</p></div><a class="btn btn-primary" asp-action="Create">+ New ticket</a></div>
@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }
<form class="card card-body mb-3" method="get"><div class="row g-2"><div class="col-md-6"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search by subject or company" /></div><div class="col-md-3"><select class="form-select" name="statusId" asp-items="ViewBag.StatusId"><option value="">All statuses</option></select></div><div class="col-md-3"><button class="btn btn-outline-primary">Search</button> <a class="btn btn-link" asp-action="Index">Clear</a></div></div></form>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>#</th><th>Subject</th><th>Customer</th><th>Category</th><th>Priority</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var ticket in Model) { <tr><td>@ticket.Id</td><td>@ticket.Subject</td><td>@ticket.Customer.CompanyName</td><td>@ticket.Category.Name</td><td><span class="badge priority-@ticket.Priority.Name.ToLower()">@ticket.Priority.Name</span></td><td>@ticket.Status.Name</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@ticket.Id">View</a></td></tr> }</tbody></table></div></div>
